# Postgres connection string (Neon / Vercel Postgres / any). Without it, a
# JSON-file store is used — fine locally, not persistent on serverless.
DATABASE_URL=

# Random secret for signing session tokens (required in production).
AUTH_SECRET=

# AI provider keys — the base layer; values saved in Admin → Settings override these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Password for the seeded "admin" account (defaults to 123456 — change it!).
ADMIN_PASSWORD=
