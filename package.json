{
  "name": "sketchart-next",
  "version": "2.0.0",
  "private": true,
  "description": "SketchLearn — AI-drawn adaptive learning slides (Next.js + TypeScript)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:pull-json": "node scripts/pseudo-db-sync.cjs pull",
    "db:push-json": "node scripts/pseudo-db-sync.cjs push",
