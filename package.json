    "@vercel/blob": "^2.6.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.0"
  }
